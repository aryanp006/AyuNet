CREATE QUERY findTreatmentPath(STRING disease_name) FOR GRAPH AyuNet {
  /*
   * Q3: Treatment Pathway Finder
   * Input: disease name
   * Traverse: Disease -> Specialist (REFERS_TO), Disease -> Treatment (TREATED_BY) -> Drug (PRESCRIBED)
   * Output: full pathway with success_rate and cost info
   */

  TYPEDEF TUPLE<STRING treatment_name, STRING treatment_type, STRING cost_tier, FLOAT success_rate, FLOAT accessibility, STRING drug_name, STRING drug_class, STRING dosage, STRING duration> PathwayResult;
  TYPEDEF TUPLE<STRING specialist_name, STRING specialization> SpecialistResult;

  ListAccum<PathwayResult> @@pathways;
  ListAccum<SpecialistResult> @@specialists;

  // Animation sequence
  ListAccum<STRING> @@hop1_nodes;  // Disease
  ListAccum<STRING> @@hop2_nodes;  // Specialist + Treatment
  ListAccum<STRING> @@hop3_nodes;  // Drug
  ListAccum<STRING> @@all_edges;

  // Find the disease
  AllDiseases = {Disease.*};
  TargetDisease = SELECT d FROM AllDiseases:d
                  WHERE d.name == disease_name
                  ACCUM @@hop1_nodes += d.name;

  // Hop 1: Disease -> Specialist
  Specialists = SELECT s FROM TargetDisease:d -(REFERS_TO:e)- Specialist:s
                ACCUM
                  @@hop2_nodes += s.name,
                  @@all_edges += (d.name + " -> " + s.name),
                  @@specialists += SpecialistResult(s.name, s.specialization);

  // Hop 2: Disease -> Treatment -> Drug
  Drugs = SELECT dr FROM TargetDisease:d -(TREATED_BY:tb)- Treatment:t -(PRESCRIBED:p)- Drug:dr
          ACCUM
            @@hop2_nodes += t.name,
            @@hop3_nodes += dr.name,
            @@all_edges += (d.name + " -> " + t.name + " [" + to_string(tb.success_rate) + "]"),
            @@all_edges += (t.name + " -> " + dr.name),
            @@pathways += PathwayResult(
              t.name, t.treatment_type, t.cost_tier,
              tb.success_rate, tb.accessibility_score,
              dr.name, dr.drug_class, p.dosage, p.duration
            );

  PRINT @@pathways AS pathways;
  PRINT @@specialists AS specialists;
  PRINT @@hop1_nodes AS hop1_disease;
  PRINT @@hop2_nodes AS hop2_specialist_treatment;
  PRINT @@hop3_nodes AS hop3_drugs;
  PRINT @@all_edges AS edges;
}
