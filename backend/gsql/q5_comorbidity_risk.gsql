CREATE QUERY predictComorbidityRisk(STRING patient_id) FOR GRAPH AyuNet {
  /*
   * Q5: Comorbidity Risk Predictor (4-hop)
   * Hop 1: Patient -> existing Disease conditions (HAS_CONDITION)
   * Hop 2: Each Disease -> RiskFactor nodes (RISK_INCREASES)
   * Hop 3: RiskFactor -> other Diseases they elevate (ELEVATES)
   * Hop 4: Predicted Disease -> LabTest (filter by incomplete)
   */

  TYPEDEF TUPLE<STRING predicted_disease, STRING icd_code, FLOAT risk_score, STRING via_risk_factor, STRING required_test, BOOL test_completed> RiskResult;

  ListAccum<RiskResult> @@risk_predictions;

  ListAccum<STRING> @@hop1_nodes;
  ListAccum<STRING> @@hop2_nodes;
  ListAccum<STRING> @@hop3_nodes;
  ListAccum<STRING> @@hop4_nodes;

  SetAccum<STRING> @@completed_tests;
  SetAccum<STRING> @@existing_disease_ids;

  SumAccum<FLOAT> @risk_multiplier;
  SetAccum<STRING> @via_factors;

  // Get the patient
  PatientSet = {Patient.*};
  ThePatient = SELECT p FROM PatientSet:p WHERE p.patient_id == patient_id;

  // Get completed tests
  CompletedTests = SELECT lt FROM ThePatient:p -(HAS_COMPLETED_TEST)- LabTest:lt
                   ACCUM @@completed_tests += lt.name;

  // Hop 1: Patient -> Disease (existing conditions)
  ExistingDiseases = SELECT d FROM ThePatient:p -(HAS_CONDITION:e)- Disease:d
                     WHERE e.status == "active"
                     ACCUM @@hop1_nodes += d.name,
                           @@existing_disease_ids += d.disease_id;

  // Hop 2: Disease -> RiskFactor
  RiskFactors = SELECT rf FROM ExistingDiseases:d -(RISK_INCREASES)- RiskFactor:rf
                ACCUM @@hop2_nodes += rf.name;

  // Hop 3: RiskFactor -> Disease (predicted, accumulate multipliers)
  PredictedDiseases = SELECT d FROM RiskFactors:rf -(ELEVATES:e)- Disease:d
                      WHERE d.disease_id NOT IN @@existing_disease_ids
                      ACCUM
                        d.@risk_multiplier += e.multiplier,
                        d.@via_factors += rf.name,
                        @@hop3_nodes += d.name;

  // Filter to meaningful risk
  PredictedDiseases = SELECT d FROM PredictedDiseases:d
                      WHERE d.@risk_multiplier > 1.0;

  // Hop 4: Predicted Disease -> LabTest
  RequiredTests = SELECT lt FROM PredictedDiseases:d -(REQUIRES_TEST)- LabTest:lt
                  ACCUM
                    @@hop4_nodes += lt.name,
                    FOREACH f IN d.@via_factors DO
                      IF lt.name IN @@completed_tests THEN
                        @@risk_predictions += RiskResult(d.name, d.icd_code, d.@risk_multiplier, f, lt.name, true)
                      ELSE
                        @@risk_predictions += RiskResult(d.name, d.icd_code, d.@risk_multiplier, f, lt.name, false)
                      END
                    END;

  PRINT @@risk_predictions AS predictions;
  PRINT @@completed_tests AS completed_tests;
  PRINT @@hop1_nodes AS hop1_existing_diseases;
  PRINT @@hop2_nodes AS hop2_risk_factors;
  PRINT @@hop3_nodes AS hop3_predicted_diseases;
  PRINT @@hop4_nodes AS hop4_required_tests;
}
