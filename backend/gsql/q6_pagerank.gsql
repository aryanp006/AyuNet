CREATE QUERY rankDiseases() FOR GRAPH AyuNet {
  /*
   * Q6: Graph-Native PageRank on Disease Network
   * Iterative PageRank on Disease subgraph connected via shared symptoms
   * Output: disease names + pagerank scores for differential diagnosis weighting
   */

  TYPEDEF TUPLE<STRING disease_name, STRING icd_code, FLOAT pagerank_score, INT connection_count> RankResult;

  HeapAccum<RankResult>(20, pagerank_score DESC) @@ranked_diseases;

  SumAccum<FLOAT> @pagerank;
  SumAccum<FLOAT> @received_score;
  SumAccum<INT> @connections;
  SumAccum<INT> @@num_diseases;

  FLOAT damping = 0.85;
  INT max_iter = 10;

  AllDiseases = {Disease.*};

  // Count diseases
  AllDiseases = SELECT d FROM AllDiseases:d
                POST-ACCUM @@num_diseases += 1;

  // Initialize PageRank
  AllDiseases = SELECT d FROM AllDiseases:d
                POST-ACCUM d.@pagerank = 1.0 / @@num_diseases;

  // Count connections per disease (via shared symptoms)
  AllDiseases = SELECT d FROM AllDiseases:d -(HAS_SYMPTOM)- Symptom:s -(HAS_SYMPTOM)- Disease:d2
                WHERE d != d2
                ACCUM d.@connections += 1;

  // Iterative PageRank
  INT iter = 0;
  WHILE iter < max_iter DO
    AllDiseases = SELECT d FROM AllDiseases:d -(HAS_SYMPTOM)- Symptom:s -(HAS_SYMPTOM)- Disease:d2
                  WHERE d != d2
                  ACCUM
                    d.@received_score += d2.@pagerank / (CASE WHEN d2.@connections > 0 THEN d2.@connections ELSE 1 END)
                  POST-ACCUM
                    d.@pagerank = (1.0 - damping) / @@num_diseases + damping * d.@received_score,
                    d.@received_score = 0;
    iter = iter + 1;
  END;

  // Collect results
  AllDiseases = SELECT d FROM AllDiseases:d
                POST-ACCUM @@ranked_diseases += RankResult(d.name, d.icd_code, d.@pagerank, d.@connections);

  PRINT @@ranked_diseases AS rankings;
}
